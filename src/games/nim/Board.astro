---
import TableroJuego from '../../components/TableroJuego.astro';

const FILAS_INICIALES = [1, 3, 5, 7];
---

<TableroJuego class="tablero-nim">
  <div id="tablero" class="tablero" role="grid" aria-label="Pirámide de estrellas de Nim: filas de 1, 3, 5 y 7">
    {FILAS_INICIALES.map((cantidad, fila) => (
      <div class="tablero__fila" role="row">
        {Array.from({ length: cantidad }, (_, pos) => (
          <button
            type="button"
            class="estrella"
            data-fila={fila}
            data-pos={pos}
            aria-label={`Fila ${fila + 1}, estrella ${pos + 1} de ${cantidad}`}
          >⭐</button>
        ))}
      </div>
    ))}
  </div>

  <div id="barra-confirmar" class="barra-confirmar" hidden>
    <span id="barra-texto" class="barra-confirmar__texto"></span>
    <button type="button" id="nim-confirmar" class="barra-confirmar__btn barra-confirmar__btn--ok">Confirmar</button>
    <button type="button" id="nim-cancelar" class="barra-confirmar__btn">Cancelar</button>
  </div>
</TableroJuego>

<style>
  .tablero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: min(92vw, 30rem);
    margin: 0 auto;
    padding: 1rem;
    touch-action: manipulation;
  }

  .tablero__fila {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .estrella {
    aspect-ratio: 1;
    width: clamp(2rem, 10vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.2rem, 6vw, 2rem);
    line-height: 1;
    background: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
    padding: 0;
    cursor: pointer;
    transition: transform 0.1s ease, opacity 0.2s ease, background 0.15s ease;
  }

  .estrella:not(:disabled):hover {
    transform: scale(1.1);
  }

  .estrella--preview {
    background: rgba(0, 0, 0, 0.08);
  }

  .estrella--seleccionada {
    background: color-mix(in srgb, var(--color-accent) 25%, transparent);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .estrella--quitada {
    opacity: 0.15;
    filter: grayscale(1);
    pointer-events: none;
  }

  .estrella--ultima {
    border-color: var(--color-accent);
    opacity: 0.4;
  }

  .barra-confirmar[hidden] {
    display: none;
  }

  .barra-confirmar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .barra-confirmar__texto {
    font-weight: 700;
  }

  .barra-confirmar__btn {
    min-height: var(--tap-target-min);
    padding: 0 1rem;
    border-radius: 8px;
    border: 2px solid var(--color-accent);
    background: transparent;
    color: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .barra-confirmar__btn--ok {
    background: var(--color-accent);
    color: #fff;
  }
</style>

<script>
  import {
    createInitialState,
    esJugadaValida,
    playMove,
    type NimState,
    type NimMove,
  } from './engine';
  import { iniciarSesionJuego } from '../../lib/gameSession';

  const tablero = document.getElementById('tablero')!;
  const estrellas = Array.from(
    tablero.querySelectorAll<HTMLButtonElement>('.estrella')
  );
  const barra = document.getElementById('barra-confirmar')!;
  const barraTexto = document.getElementById('barra-texto')!;
  const btnConfirmar = document.getElementById('nim-confirmar') as HTMLButtonElement;
  const btnCancelar = document.getElementById('nim-cancelar') as HTMLButtonElement;

  let state: NimState = createInitialState();
  let seleccion: NimMove | null = null;

  const sesion = iniciarSesionJuego<NimMove>({
    validarMovimiento: esJugadaValida,
    onMovimientoRemoto: move => jugar(move, false),
    onAplicarReinicio: () => {
      state = createInitialState();
      seleccion = null;
      render();
    },
    onRender: render,
    onDesconectar: () => {
      estrellas.forEach(e => (e.disabled = true));
      barra.hidden = true;
    },
  });

  function filaPos(e: HTMLButtonElement): { fila: number; pos: number } {
    return { fila: Number(e.dataset.fila), pos: Number(e.dataset.pos) };
  }

  function limpiarPreview(): void {
    estrellas.forEach(e => e.classList.remove('estrella--preview'));
  }

  function render(): void {
    const jugadorDelTurno = state.currentPlayer;
    const esMiTurno = sesion.esMiTurno(jugadorDelTurno);

    estrellas.forEach(e => {
      const { fila, pos } = filaPos(e);
      const quitada = pos >= state.montones[fila];
      const esUltima =
        !!state.lastMove &&
        state.lastMove.fila === fila &&
        pos >= state.montones[fila] &&
        pos < state.montones[fila] + state.lastMove.quitadas;
      const enSeleccion =
        !!seleccion && seleccion.fila === fila && pos >= seleccion.dejar && !quitada;

      e.classList.toggle('estrella--quitada', quitada);
      e.classList.toggle('estrella--ultima', esUltima && quitada);
      e.classList.toggle('estrella--seleccionada', enSeleccion);
      e.disabled = quitada || state.status !== 'playing' || !esMiTurno;
    });

    if (seleccion && state.status === 'playing' && esMiTurno) {
      const quitadas = state.montones[seleccion.fila] - seleccion.dejar;
      barraTexto.textContent = `Quitar ${quitadas} ${
        quitadas === 1 ? 'estrella' : 'estrellas'
      } de la fila ${seleccion.fila + 1}`;
      barra.hidden = false;
    } else {
      barra.hidden = true;
    }

    if (state.status === 'playing') {
      sesion.mostrarTurno({ jugador: jugadorDelTurno });
    } else if (state.status === 'won') {
      sesion.mostrarFinDeJuego({
        titulo: `🎉 ¡Ganó ${sesion.nombres[state.winner!]}! ⭐`,
      });
    }
  }

  function jugar(move: NimMove, emitirRemoto = true): void {
    state = playMove(state, move);
    seleccion = null;
    limpiarPreview();
    render();
    if (emitirRemoto) {
      sesion.enviarMovimiento(move);
    }
  }

  estrellas.forEach(estrella => {
    estrella.addEventListener('click', () => {
      const { fila, pos } = filaPos(estrella);
      if (seleccion && seleccion.fila === fila && seleccion.dejar === pos) {
        jugar({ fila, dejar: pos });
        return;
      }
      seleccion = { fila, dejar: pos };
      limpiarPreview();
      render();
    });

    estrella.addEventListener('pointerenter', () => {
      if (estrella.disabled) return;
      const { fila, pos } = filaPos(estrella);
      limpiarPreview();
      estrellas.forEach(e => {
        const fp = filaPos(e);
        if (fp.fila === fila && fp.pos >= pos && fp.pos < state.montones[fila]) {
          e.classList.add('estrella--preview');
        }
      });
    });
  });

  tablero.addEventListener('pointerleave', limpiarPreview);

  btnConfirmar.addEventListener('click', () => {
    if (seleccion) jugar({ fila: seleccion.fila, dejar: seleccion.dejar });
  });

  btnCancelar.addEventListener('click', () => {
    seleccion = null;
    limpiarPreview();
    render();
  });

  render();
</script>
