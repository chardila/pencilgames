---
// Miniatura SVG del tablero de cada juego. Lienzo 48×48, trazo 2.5 redondeado,
// estructura en currentColor y fichas en los colores de jugador.
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const P1 = 'var(--a)';
const P2 = 'var(--b)';
const AC = 'var(--c)';

const r = (n: number) => Math.round(n * 100) / 100;

const punto = (x: number, y: number, c = 'currentColor', rad = 2) =>
  `<circle cx="${x}" cy="${y}" r="${rad}" fill="${c}"/>`;

const hex = (cx: number, cy: number, rad: number, fill = 'none') => {
  const pts = [0, 1, 2, 3, 4, 5].map(i => {
    const a = (Math.PI / 180) * (60 * i - 30);
    return `${r(cx + rad * Math.cos(a))},${r(cy + rad * Math.sin(a))}`;
  });
  return `<polygon points="${pts.join(' ')}" fill="${fill}"/>`;
};

const estrella = (cx: number, cy: number, R: number, extra = '') => {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const rad = i % 2 === 0 ? R : R * 0.45;
    const a = (Math.PI / 180) * (36 * i - 90);
    return `${r(cx + rad * Math.cos(a))},${r(cy + rad * Math.sin(a))}`;
  });
  return `<polygon points="${pts.join(' ')}" ${extra}/>`;
};

const equis = (cx: number, cy: number, d: number, c: string) =>
  `<path d="M${cx - d} ${cy - d}L${cx + d} ${cy + d}M${cx + d} ${cy - d}L${cx - d} ${cy + d}" stroke="${c}"/>`;

// Panal en rombo 3×3 para Hex.
const panal = () => {
  const rad = 6;
  const w = rad * Math.sqrt(3);
  const colores: Record<string, string> = {
    '0,0': P1,
    '1,1': P1,
    '2,1': P2,
    '0,2': P2,
  };
  let s = '';
  for (let i = 0; i < 3; i++) {
    for (let j = 0; j < 3; j++) {
      const cx = 4 + w / 2 + i * (w / 2) + j * w;
      const cy = 12 + i * 9;
      s += hex(cx, cy, rad - 0.6, colores[`${i},${j}`] ? `${colores[`${i},${j}`]}` : 'none');
    }
  }
  return `<g stroke-width="2">${s}</g>`;
};

const cuadricula = (x0: number, y0: number, paso: number, n: number) => {
  const fin = x0 + paso * (n - 1);
  let s = '';
  for (let k = 0; k < n; k++) {
    const p = x0 + paso * k;
    s += `M${x0} ${p - x0 + y0}H${fin}M${p} ${y0}V${y0 + paso * (n - 1)}`;
  }
  return `<path d="${s}" stroke-width="1.5" opacity=".45"/>`;
};

const ICONOS: Record<string, string> = {
  'agujero-negro':
    `<circle cx="24" cy="24" r="13" stroke-dasharray="3 4.5"/>` +
    `<circle cx="24" cy="24" r="6.5" fill="currentColor"/>` +
    punto(8, 8, P1, 4) + punto(40, 40, P1, 4) + punto(40, 8, P2, 4) + punto(8, 40, P2, 4),
  battleship:
    `<path d="M7 27H41L35 36H13Z" fill="${P2}"/>` +
    `<path d="M17 27V20H28V27M28 22H33"/>` +
    `<path d="M6 42q4-3.5 8 0t8 0t8 0t8 0t8 0"/>`,
  'bridg-it':
    punto(10, 10, P1, 3.5) + punto(24, 24, P1, 3.5) + punto(38, 38, P1, 3.5) +
    punto(38, 10, P1, 3.5) + punto(10, 38, P1, 3.5) +
    punto(24, 10, P2, 3.5) + punto(10, 24, P2, 3.5) + punto(38, 24, P2, 3.5) + punto(24, 38, P2, 3.5) +
    `<path d="M10 10L24 24" stroke="${P1}"/><path d="M38 24L24 38" stroke="${P2}"/>` +
    `<path d="M38 10L24 24" stroke="${P1}"/>`,
  chomp:
    [0, 1, 2]
      .flatMap(f => [0, 1, 2, 3].map(c => [f, c]))
      .filter(([f, c]) => !(f === 0 && c >= 2) && !(f === 1 && c === 3))
      .map(([f, c]) => `<rect x="${6 + c * 10}" y="${10 + f * 10}" width="8.5" height="8.5" rx="2" stroke-width="2"${f === 2 && c === 0 ? ` fill="${P1}"` : ''}/>`)
      .join(''),
  col:
    `<rect x="6" y="6" width="17" height="19" rx="3" fill="${P1}"/>` +
    `<rect x="27" y="6" width="15" height="11" rx="3" fill="${P2}"/>` +
    `<rect x="27" y="21" width="15" height="21" rx="3"/>` +
    `<rect x="6" y="29" width="17" height="13" rx="3" fill="${P1}"/>`,
  conquista:
    `<path d="M12 8V32"/><path d="M12 8L34 14L12 20Z" fill="${P1}"/>` +
    `<path d="M8 40H30" stroke="${P2}"/>` +
    punto(8, 40, 'currentColor', 2.5) + punto(19, 40, 'currentColor', 2.5) + punto(30, 40, 'currentColor', 2.5) + punto(41, 40, 'currentColor', 2.5),
  domineering:
    cuadricula(6, 6, 12, 4) +
    `<rect x="6" y="6" width="36" height="36" rx="4"/>` +
    `<rect x="9" y="9" width="30" height="12" rx="3" fill="${P1}" stroke="none" opacity=".9"/>` +
    `<rect x="27" y="24" width="12" height="15" rx="3" fill="${P2}" stroke="none" opacity=".9"/>`,
  estampida:
    punto(9, 14, P1, 4.5) + punto(9, 34, P1, 4.5) +
    `<path d="M19 24H41M34 17L41 24L34 31"/>` +
    punto(28, 10, P1, 3) + punto(40, 10, P1, 3) + punto(28, 38, P1, 3) + punto(40, 38, P1, 3),
  gomoku:
    cuadricula(8, 8, 8, 5) +
    [0, 1, 2, 3, 4].map(k => punto(8 + 8 * k, 8 + 8 * k, P1, 3.6)).join('') +
    punto(16, 8, P2, 3.6) + punto(32, 40, P2, 3.6) + punto(40, 24, P2, 3.6),
  hex: panal(),
  'juego-y':
    `<path d="M24 6L43 40H5Z"/>` +
    `<path d="M24 29V17M24 29L14 35M24 29L34 35" stroke="${P1}" stroke-width="3"/>` +
    punto(24, 29, P1, 3.5),
  metasquares:
    [9, 19, 29, 39].flatMap(x => [9, 19, 29, 39].map(y => punto(x, y, 'currentColor', 1.6))).join('') +
    `<path d="M19 9L29 19L19 29L9 19Z" stroke="${P1}"/>` +
    punto(19, 9, P1, 3) + punto(29, 19, P1, 3) + punto(19, 29, P1, 3) + punto(9, 19, P1, 3) +
    punto(29, 29, P2, 3) + punto(39, 29, P2, 3) + punto(29, 39, P2, 3) + punto(39, 39, P2, 3),
  nim:
    [1, 3, 5]
      .map((n, f) =>
        Array.from({ length: n }, (_, k) => {
          const x = 24 + (k - (n - 1) / 2) * 8.6;
          const y = 10 + f * 14;
          const quitada = f === 2 && k >= 3;
          return estrella(x, y, 5.2, quitada ? `fill="none" stroke-width="1" opacity=".3"` : `fill="${AC}" stroke-width="1.3"`);
        }).join(''),
      )
      .join(''),
  notakto:
    `<path d="M18 6V42M30 6V42M6 18H42M6 30H42" opacity=".45"/>` +
    equis(12, 12, 4.5, 'currentColor') + equis(36, 12, 4.5, 'currentColor') +
    equis(24, 24, 4.5, 'currentColor') + equis(12, 36, 4.5, 'currentColor'),
  obstruccion:
    [0, 1, 2, 3]
      .flatMap(f => [0, 1, 2, 3].map(c => [f, c]))
      .map(([f, c]) => {
        const bloq = (f <= 2 && c <= 2) || (f >= 2 && c >= 2);
        const fich = (f === 1 && c === 1) ? P1 : (f === 3 && c === 3) ? P2 : '';
        const fill = fich || (bloq ? 'currentColor' : 'none');
        const op = fich ? '' : bloq ? ' opacity=".18"' : '';
        return `<rect x="${6 + c * 9.5}" y="${6 + f * 9.5}" width="8" height="8" rx="2" stroke-width="2" fill="${fill}"${op}/>`;
      })
      .join(''),
  'puntos-y-cajas':
    [8, 24, 40].flatMap(x => [8, 24, 40].map(y => punto(x, y, 'currentColor', 2.5))).join('') +
    `<rect x="8" y="8" width="16" height="16" fill="${P1}" fill-opacity=".25" stroke="${P1}"/>` +
    `<path d="M24 24H40V40" stroke="${P2}"/>`,
  sim:
    (() => {
      const v = [0, 1, 2, 3, 4, 5].map(i => {
        const a = (Math.PI / 180) * (60 * i - 90);
        return [r(24 + 16 * Math.cos(a)), r(24 + 16 * Math.sin(a))];
      });
      const l = (a: number, b: number, c: string) => `<path d="M${v[a]}L${v[b]}" stroke="${c}"/>`;
      return l(0, 2, P1) + l(2, 4, P1) + l(1, 3, P2) + l(3, 5, P2) + l(0, 3, 'currentColor') +
        v.map(([x, y]) => punto(x, y, 'currentColor', 3)).join('');
    })(),
  snakes:
    `<path d="M8 40V28H22V14H38" stroke="${P1}" stroke-width="5"/>` +
    punto(38, 14, P1, 5.5) + punto(40, 12.5, '#fff', 1.4) +
    `<path d="M40 40V32" stroke="${P2}" stroke-width="5"/>` + punto(40, 30, P2, 5.5),
  sos:
    [0, 1, 2]
      .map(k => `<rect x="${4 + k * 14.5}" y="14" width="13" height="20" rx="3" stroke-width="2"/>`)
      .join('') +
    [['S', 10.5, P1], ['O', 25, P2], ['S', 39.5, P1]]
      .map(([t, x, c]) => `<text x="${x}" y="30" text-anchor="middle" fill="${c}">${t}</text>`)
      .join(''),
  'tres-en-raya':
    `<path d="M18 6V42M30 6V42M6 18H42M6 30H42" opacity=".45"/>` +
    punto(12, 12, P1, 4.5) + punto(24, 24, P1, 4.5) + punto(36, 36, P1, 4.5) +
    equis(36, 12, 4.5, P2) + equis(12, 36, 4.5, P2),
  triggle:
    `<path d="M24 6L43 40H5Z"/>` +
    `<path d="M14.5 23L33.5 23L24 40Z" stroke-width="1.8"/>` +
    `<path d="M24 6L33.5 23L14.5 23Z" fill="${P1}" fill-opacity=".35" stroke-width="1.8"/>` +
    `<path d="M33.5 23L43 40H24Z" fill="${P2}" fill-opacity=".35" stroke-width="1.8"/>` +
    [[24, 6], [43, 40], [5, 40], [14.5, 23], [33.5, 23], [24, 40]].map(([x, y]) => punto(x, y, 'currentColor', 2.5)).join(''),
};

const svg = ICONOS[slug] ?? '';
---

<svg
  class="icono-juego"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  style="--a:var(--color-player-1);--b:var(--color-player-2);--c:var(--color-accent)"
  set:html={svg}
/>

<style is:global>
  .icono-juego circle[fill] {
    stroke: none;
  }

  .icono-juego text {
    font: 800 16px system-ui, sans-serif;
    stroke: none;
  }

  .icono-juego {
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
  }
</style>
