<div
  id="modal-jugadores"
  class="modal-jugadores"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-jugadores-titulo"
  hidden
>
  <div class="modal-jugadores__contenido">
    <h2 id="modal-jugadores-titulo">¿Quién juega?</h2>
    <label class="modal-jugadores__campo">
      Nombre del jugador 1
      <input type="text" id="input-jugador-1" maxlength="16" placeholder="Jugador 1" />
    </label>
    <label class="modal-jugadores__campo">
      Nombre del jugador 2
      <input type="text" id="input-jugador-2" maxlength="16" placeholder="Jugador 2" />
    </label>
    <p id="jugadores-error" class="jugadores-error" hidden>
      Los jugadores no pueden tener el mismo nombre.
    </p>
    <button type="button" id="modal-jugadores-guardar" class="modal-jugadores__guardar">
      Guardar
    </button>
  </div>
</div>

<div class="barra-superior-juego">
  <button type="button" id="modal-jugadores-abrir" class="modal-jugadores__abrir" hidden>
    ✏️ Cambiar nombres
  </button>

  <button type="button" id="boton-jugar-por-internet" class="modal-jugadores__abrir" hidden>
    🌐 Por internet
  </button>
</div>

<style>
  .modal-jugadores {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing);
    z-index: 20;
  }

  .modal-jugadores[hidden] {
    display: none;
  }

  .modal-jugadores__contenido {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    max-width: 24rem;
    width: 100%;
  }

  .modal-jugadores__campo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
    font-weight: 700;
  }

  .modal-jugadores__campo input {
    padding: 0.75rem;
    font-size: 1rem;
    border-radius: var(--radius);
    border: 1px solid #ddd;
    min-height: var(--tap-target-min);
    font-weight: 400;
  }

  .jugadores-error {
    margin-top: 1rem;
    color: #b00020;
    font-weight: 700;
  }

  .jugadores-error[hidden] {
    display: none;
  }

  .modal-jugadores__guardar {
    margin-top: 1.5rem;
    width: 100%;
    padding: 0.75rem;
    border: none;
    border-radius: var(--radius);
    background: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 700;
    min-height: var(--tap-target-min);
    min-width: var(--tap-target-min);
  }

  .barra-superior-juego {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0 var(--spacing);
  }

  .modal-jugadores__abrir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #ddd;
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 700;
    min-height: var(--tap-target-min);
  }

  .modal-jugadores__abrir[hidden] {
    display: none;
  }

  /* R5 — en horizontal con poca altura, la barra se superpone a la cabecera
     en vez de ocupar su propia fila, para no robarle esos ~44 px de alto al
     tablero. Los botones van dentro de un solo contenedor fijo, en fila, en
     vez de fijar cada botón por separado (eso los hacía superponerse). */
  @media (orientation: landscape) and (height <= 46rem) {
    .barra-superior-juego {
      position: fixed;
      top: 0.25rem;
      right: 0.5rem;
      z-index: 5;
      padding: 0;
      gap: 0.35rem;
    }

    .modal-jugadores__abrir {
      padding: 0.35rem 0.6rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  import { DEFAULTS, getPlayerNames, nombresColisionan, savePlayerNames } from '../lib/players';

  const modal = document.getElementById('modal-jugadores')!;
  const abrir = document.getElementById('modal-jugadores-abrir')!;
  const botonPorInternet = document.getElementById('boton-jugar-por-internet')!;
  const guardar = document.getElementById('modal-jugadores-guardar')!;
  const inputJugador1 = document.getElementById('input-jugador-1') as HTMLInputElement;
  const inputJugador2 = document.getElementById('input-jugador-2') as HTMLInputElement;
  const errorTexto = document.getElementById('jugadores-error')!;

  function cargarInputs(): void {
    const nombres = getPlayerNames();
    inputJugador1.value = nombres[1];
    inputJugador2.value = nombres[2];
    errorTexto.hidden = true;
  }

  cargarInputs();

  abrir.addEventListener('click', () => {
    cargarInputs();
    modal.hidden = false;
  });

  // R4: camino visible a "Por internet" en la barra superior, junto a
  // "Cambiar nombres", ya sin depender de que reaparezca el modal
  // "¿Cómo van a jugar?" (que ahora se salta si ya hay un modo guardado).
  // Dispara el mismo evento que el botón del modal de modo.
  botonPorInternet.addEventListener('click', () => {
    // A diferencia de los botones "por internet" del modal de reglas y del
    // modal de modo (que eligen el modo antes de que haya uno activo), este
    // es un atajo a mitad de partida en modo local: no persiste 'remoto'
    // aquí, porque si el usuario cancela la conexión, ModalModoJuego no
    // tiene ocasión de sobrescribirlo con 'local' de nuevo (ya no se
    // muestra ese paso una vez el modo está elegido) y el valor se quedaría
    // pegado en 'remoto' para todas las entradas futuras a cualquier juego.
    document.dispatchEvent(new CustomEvent('abrir-modal-remoto'));
  });

  guardar.addEventListener('click', () => {
    // Mismo trim+fallback que aplica savePlayerNames al persistir — se
    // compara sobre los nombres ya resueltos para que dos campos vacíos
    // (que caen a defaults distintos) nunca cuenten como colisión.
    const nombre1 = inputJugador1.value.trim() || DEFAULTS[1];
    const nombre2 = inputJugador2.value.trim() || DEFAULTS[2];
    if (nombresColisionan(nombre1, nombre2)) {
      errorTexto.hidden = false;
      return;
    }
    errorTexto.hidden = true;
    const nuevosNombres = { 1: nombre1, 2: nombre2 };
    savePlayerNames(nuevosNombres);
    document.dispatchEvent(
      new CustomEvent('nombres-jugadores-actualizados', { detail: nuevosNombres })
    );
    modal.hidden = true;
  });
</script>
