---
import { DIFICULTADES, DIFICULTAD_INFO } from '../lib/bot/tipos';

interface Props {
  soportaSolo?: boolean;
}

const { soportaSolo = false } = Astro.props;
---

<div
  id="modal-modo-juego"
  class="modal-modo-juego"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-modo-juego-titulo"
  data-soporta-solo={soportaSolo ? 'true' : 'false'}
  hidden
>
  <div class="modal-modo-juego__contenido">
    <h2 id="modal-modo-juego-titulo">¿Cómo van a jugar?</h2>

    <div id="modal-modo-juego-paso-modo" class="modal-modo-juego__paso">
      {
        soportaSolo && (
          <button type="button" id="modal-modo-juego-solo" class="modal-modo-juego__boton">
            🤖 Jugar solo
          </button>
        )
      }
      <button type="button" id="modal-modo-juego-local" class="modal-modo-juego__boton">
        📱 Misma tableta
      </button>
      <button type="button" id="modal-modo-juego-remoto" class="modal-modo-juego__boton">
        🌐 Por internet
      </button>
      <a href="/" class="modal-modo-juego__volver">← Volver a los juegos</a>
    </div>

    {
      soportaSolo && (
        <div id="modal-modo-juego-paso-dificultad" class="modal-modo-juego__paso" hidden>
          {DIFICULTADES.map(nivel => {
            const info = DIFICULTAD_INFO[nivel];
            return (
              <button
                type="button"
                class="modal-modo-juego__dificultad"
                data-dificultad={nivel}
              >
                <span class="modal-modo-juego__dificultad-titulo">
                  {info.icono} {info.texto}
                </span>
                <span class="modal-modo-juego__dificultad-desc">{info.descripcion}</span>
              </button>
            );
          })}
          <button type="button" id="modal-modo-juego-volver-modo" class="modal-modo-juego__volver-btn">
            ← Otro modo
          </button>
        </div>
      )
    }
  </div>
</div>

<style>
  .modal-modo-juego {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing);
    z-index: 20;
  }

  .modal-modo-juego[hidden] {
    display: none;
  }

  .modal-modo-juego__contenido {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    max-width: 24rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-modo-juego__paso {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-modo-juego__paso[hidden] {
    display: none;
  }

  .modal-modo-juego__boton {
    padding: 0.75rem;
    border: none;
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 1.1rem;
    font-weight: 700;
    min-height: 3rem;
    min-width: var(--tap-target-min);
  }

  .modal-modo-juego__dificultad {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 3.5rem;
    text-align: left;
  }

  .modal-modo-juego__dificultad-titulo {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .modal-modo-juego__dificultad-desc {
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .modal-modo-juego__volver {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target-min);
    margin-top: 0.5rem;
    padding: 0.5rem;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }

  .modal-modo-juego__volver-btn {
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
    min-height: 3rem;
  }
</style>

<script>
  import { esDificultad } from '../lib/bot/tipos';
  import {
    getDificultadGuardada,
    getModoGuardado,
    guardarDificultad,
    guardarModo,
    olvidarModo,
  } from '../lib/entrada';

  const modal = document.getElementById('modal-modo-juego')!;
  const titulo = document.getElementById('modal-modo-juego-titulo')!;
  const pasoModo = document.getElementById('modal-modo-juego-paso-modo')!;
  const pasoDificultad = document.getElementById('modal-modo-juego-paso-dificultad');
  const botonSolo = document.getElementById('modal-modo-juego-solo');
  const botonLocal = document.getElementById('modal-modo-juego-local')!;
  const botonRemoto = document.getElementById('modal-modo-juego-remoto')!;
  const botonVolverModo = document.getElementById('modal-modo-juego-volver-modo');
  const botonesDificultad = Array.from(
    modal.querySelectorAll<HTMLButtonElement>('.modal-modo-juego__dificultad')
  );
  const soportaSolo = modal.dataset.soportaSolo === 'true';

  // Se acuerda si ya se eligió modo para no volver a mostrar este paso
  // cuando se reabren las instrucciones a mitad de partida (botón "?" de
  // ModalInstrucciones) y se cierran de nuevo. Solo vuelve a false si el
  // usuario cancela el flujo remoto (modal-remoto-cancelado) y hay que
  // elegir modo otra vez.
  let modoYaElegido = false;

  // Distingue el cancelar de "por internet" ANTES de que el tablero esté a
  // la vista (había que dejar elegir modo otra vez) del cancelar del atajo
  // de mitad de partida en la cabecera (el tablero ya está en pantalla:
  // no hay que taparlo con "¿Cómo van a jugar?" de nuevo).
  let tableroVisible = false;

  function mostrarPasoModo(): void {
    titulo.textContent = '¿Cómo van a jugar?';
    pasoModo.hidden = false;
    if (pasoDificultad) pasoDificultad.hidden = true;
  }

  function mostrarPasoDificultad(): void {
    titulo.textContent = 'Elige la dificultad';
    pasoModo.hidden = true;
    if (pasoDificultad) pasoDificultad.hidden = false;
  }

  // El modo local o solitario también puede quedar decidido sin pasar por aquí
  // (p. ej. "Continuar" una partida guardada salta reglas y modo). Sin esto,
  // cancelar luego "por internet" tomaría el tablero por no visible y taparía
  // la partida restaurada con "¿Cómo van a jugar?".
  document.addEventListener('modo-elegido-local', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
  });

  document.addEventListener('modo-elegido-solo', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
  });

  document.addEventListener('instrucciones-cerradas', () => {
    if (modoYaElegido) return;

    // R3: si ya hay un modo guardado de una visita anterior, nos lo saltamos
    // en vez de mostrar "¿Cómo van a jugar?" — se dispara el mismo evento
    // que dispararía el botón correspondiente. Para "remoto" eso abre el
    // modal de sala (crear/unirse), no el tablero directo: conectarse sigue
    // siendo una acción explícita.
    const modoGuardado = getModoGuardado();
    if (modoGuardado === 'solo' && soportaSolo) {
      modoYaElegido = true;
      tableroVisible = true;
      document.dispatchEvent(
        new CustomEvent('modo-elegido-solo', {
          detail: { dificultad: getDificultadGuardada() },
        })
      );
      return;
    }
    if (modoGuardado === 'local') {
      modoYaElegido = true;
      tableroVisible = true;
      document.dispatchEvent(new CustomEvent('modo-elegido-local'));
      return;
    }
    if (modoGuardado === 'remoto') {
      modoYaElegido = true;
      // 'remoto' ya estaba guardado antes de este intento: si se cancela,
      // hay que restaurarlo a sí mismo, no borrarlo (ver modoPrevioAntesDeRemoto).
      document.dispatchEvent(new CustomEvent('abrir-modal-remoto', { detail: { modoPrevio: modoGuardado } }));
      return;
    }

    mostrarPasoModo();
    modal.hidden = false;
  });

  // El botón "por internet" de ModalInstrucciones también dispara este
  // evento, pero directamente, sin pasar por 'instrucciones-cerradas' (así
  // se salta este modal). Sin este listener, modoYaElegido seguía en false
  // mientras se espera la conexión, y reabrir las reglas con "?" y volver a
  // pulsar "¡Jugar!" repetía el flujo de modo, cerrando la sala en espera.
  // Modo que había guardado antes de intentar "remoto", para poder
  // restaurarlo si cancela sin conectar (en vez de borrar una preferencia
  // 'local' o 'solo' previa que el usuario nunca tocó).
  let modoPrevioAntesDeRemoto: ReturnType<typeof getModoGuardado> = null;

  document.addEventListener('abrir-modal-remoto', ((evento: CustomEvent<{ modoPrevio?: ReturnType<typeof getModoGuardado> }>) => {
    modoYaElegido = true;
    modoPrevioAntesDeRemoto = evento.detail?.modoPrevio ?? null;
  }) as EventListener);

  document.addEventListener('modal-remoto-cancelado', () => {
    if (tableroVisible) return;
    // guardarModo('remoto') se llama al pulsar "por internet", antes de
    // confirmar conexión (para poder saltar el modal de modo la próxima
    // vez que SÍ conecte). Si cancela sin haber conectado, hay que deshacer
    // ese guardado: si no, la próxima visita a cualquier juego saltaría
    // directo al flujo de sala aunque el usuario haya cancelado, sin volver
    // a preguntar nunca. Si ya había un modo guardado de antes (p. ej.
    // 'local'), se restaura en vez de perderlo.
    if (modoPrevioAntesDeRemoto) guardarModo(modoPrevioAntesDeRemoto);
    else olvidarModo();
    modoYaElegido = false;
    mostrarPasoModo();
    modal.hidden = false;
  });

  // El deep-link ?sala=CODIGO (ModalJuegoRemoto) salta directo al paso
  // "Unirse" sin pasar nunca por los botones de este modal, así que
  // modoYaElegido seguiría en false. Sin este listener, reabrir las
  // instrucciones ("?") durante esa partida remota y cerrarlas de nuevo
  // volvería a mostrar "¿Cómo van a jugar?" encima de la partida en curso.
  //
  // Ojo: este evento también se dispara al unirse por deep-link, que no es
  // una elección real de modo (nadie tocó un botón "por internet"). Por eso
  // el modo se guarda en el click de "por internet", no aquí.
  document.addEventListener('canal-remoto-listo', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
  });

  botonSolo?.addEventListener('click', () => {
    mostrarPasoDificultad();
  });

  botonVolverModo?.addEventListener('click', () => {
    mostrarPasoModo();
  });

  for (const boton of botonesDificultad) {
    boton.addEventListener('click', () => {
      const nivel = boton.dataset.dificultad;
      if (!esDificultad(nivel)) return;
      modoYaElegido = true;
      tableroVisible = true;
      modal.hidden = true;
      guardarModo('solo');
      guardarDificultad(nivel);
      document.dispatchEvent(
        new CustomEvent('modo-elegido-solo', { detail: { dificultad: nivel } })
      );
    });
  }

  botonLocal.addEventListener('click', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
    guardarModo('local');
    document.dispatchEvent(new CustomEvent('modo-elegido-local'));
  });

  botonRemoto.addEventListener('click', () => {
    modoYaElegido = true;
    modal.hidden = true;
    const modoPrevio = getModoGuardado();
    guardarModo('remoto');
    document.dispatchEvent(new CustomEvent('abrir-modal-remoto', { detail: { modoPrevio } }));
  });
</script>
