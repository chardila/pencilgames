<div
  id="modal-modo-juego"
  class="modal-modo-juego"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-modo-juego-titulo"
  hidden
>
  <div class="modal-modo-juego__contenido">
    <h2 id="modal-modo-juego-titulo">¿Cómo van a jugar?</h2>
    <button type="button" id="modal-modo-juego-local" class="modal-modo-juego__boton">
      📱 Misma tableta
    </button>
    <button type="button" id="modal-modo-juego-remoto" class="modal-modo-juego__boton">
      🌐 Por internet
    </button>
    <a href="/" class="modal-modo-juego__volver">← Volver a los juegos</a>
  </div>
</div>

<style>
  .modal-modo-juego {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing);
    z-index: 20;
  }

  .modal-modo-juego[hidden] {
    display: none;
  }

  .modal-modo-juego__contenido {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    max-width: 24rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-modo-juego__boton {
    padding: 0.75rem;
    border: none;
    border-radius: var(--radius);
    background: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 700;
    min-height: var(--tap-target-min);
    min-width: var(--tap-target-min);
  }

  .modal-modo-juego__volver {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target-min);
    margin-top: 0.5rem;
    padding: 0.5rem;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }
</style>

<script>
  import { getModoGuardado, guardarModo, olvidarModo } from '../lib/entrada';

  const modal = document.getElementById('modal-modo-juego')!;
  const botonLocal = document.getElementById('modal-modo-juego-local')!;
  const botonRemoto = document.getElementById('modal-modo-juego-remoto')!;

  // Se acuerda si ya se eligió modo para no volver a mostrar este paso
  // cuando se reabren las instrucciones a mitad de partida (botón "?" de
  // ModalInstrucciones) y se cierran de nuevo. Solo vuelve a false si el
  // usuario cancela el flujo remoto (modal-remoto-cancelado) y hay que
  // elegir modo otra vez.
  let modoYaElegido = false;

  // Distingue el cancelar de "por internet" ANTES de que el tablero esté a
  // la vista (había que dejar elegir modo otra vez) del cancelar del atajo
  // de mitad de partida en ModalJugadores (el tablero ya está en pantalla:
  // no hay que taparlo con "¿Cómo van a jugar?" de nuevo).
  let tableroVisible = false;

  document.addEventListener('instrucciones-cerradas', () => {
    if (modoYaElegido) return;

    // R3: si ya hay un modo guardado de una visita anterior, nos lo saltamos
    // en vez de mostrar "¿Cómo van a jugar?" — se dispara el mismo evento
    // que dispararía el botón correspondiente. Para "remoto" eso abre el
    // modal de sala (crear/unirse), no el tablero directo: conectarse sigue
    // siendo una acción explícita.
    const modoGuardado = getModoGuardado();
    if (modoGuardado === 'local') {
      modoYaElegido = true;
      tableroVisible = true;
      document.dispatchEvent(new CustomEvent('modo-elegido-local'));
      return;
    }
    if (modoGuardado === 'remoto') {
      modoYaElegido = true;
      // 'remoto' ya estaba guardado antes de este intento: si se cancela,
      // hay que restaurarlo a sí mismo, no borrarlo (ver modoPrevioAntesDeRemoto).
      document.dispatchEvent(new CustomEvent('abrir-modal-remoto', { detail: { modoPrevio: modoGuardado } }));
      return;
    }

    modal.hidden = false;
  });

  // El botón "por internet" de ModalInstrucciones también dispara este
  // evento, pero directamente, sin pasar por 'instrucciones-cerradas' (así
  // se salta este modal). Sin este listener, modoYaElegido seguía en false
  // mientras se espera la conexión, y reabrir las reglas con "?" y volver a
  // pulsar "¡Jugar!" repetía el flujo de modo, cerrando la sala en espera.
  // Modo que había guardado antes de intentar "remoto", para poder
  // restaurarlo si cancela sin conectar (en vez de borrar una preferencia
  // 'local' previa que el usuario nunca tocó).
  let modoPrevioAntesDeRemoto: ReturnType<typeof getModoGuardado> = null;

  document.addEventListener('abrir-modal-remoto', ((evento: CustomEvent<{ modoPrevio?: ReturnType<typeof getModoGuardado> }>) => {
    modoYaElegido = true;
    modoPrevioAntesDeRemoto = evento.detail?.modoPrevio ?? null;
  }) as EventListener);

  document.addEventListener('modal-remoto-cancelado', () => {
    if (tableroVisible) return;
    // guardarModo('remoto') se llama al pulsar "por internet", antes de
    // confirmar conexión (para poder saltar el modal de modo la próxima
    // vez que SÍ conecte). Si cancela sin haber conectado, hay que deshacer
    // ese guardado: si no, la próxima visita a cualquier juego saltaría
    // directo al flujo de sala aunque el usuario haya cancelado, sin volver
    // a preguntar nunca. Si ya había un modo guardado de antes (p. ej.
    // 'local'), se restaura en vez de perderlo.
    if (modoPrevioAntesDeRemoto) guardarModo(modoPrevioAntesDeRemoto);
    else olvidarModo();
    modoYaElegido = false;
    modal.hidden = false;
  });

  // El deep-link ?sala=CODIGO (ModalJuegoRemoto) salta directo al paso
  // "Unirse" sin pasar nunca por los botones de este modal, así que
  // modoYaElegido seguiría en false. Sin este listener, reabrir las
  // instrucciones ("?") durante esa partida remota y cerrarlas de nuevo
  // volvería a mostrar "¿Cómo van a jugar?" encima de la partida en curso.
  //
  // Ojo: este evento también se dispara al unirse por deep-link, que no es
  // una elección real de modo (nadie tocó un botón "por internet"). Por eso
  // el modo se guarda en el click de "por internet", no aquí.
  document.addEventListener('canal-remoto-listo', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
  });

  botonLocal.addEventListener('click', () => {
    modoYaElegido = true;
    tableroVisible = true;
    modal.hidden = true;
    guardarModo('local');
    document.dispatchEvent(new CustomEvent('modo-elegido-local'));
  });

  botonRemoto.addEventListener('click', () => {
    modoYaElegido = true;
    modal.hidden = true;
    const modoPrevio = getModoGuardado();
    guardarModo('remoto');
    document.dispatchEvent(new CustomEvent('abrir-modal-remoto', { detail: { modoPrevio } }));
  });
</script>
