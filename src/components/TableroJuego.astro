---
import ControlesPartida from './ControlesPartida.astro';

interface Props {
  id?: string;
  class?: string;
  /** Número de columnas de la rejilla del juego (o lado del tablero SVG). */
  n?: number;
  /** Número de filas, si es distinto de `n` (p. ej. Chomp: 7 columnas × 4 filas). */
  filas?: number;
  /** Lado mínimo (rem) del tablero SVG: el que da ≥48px a la zona tocable más pequeña. */
  ladoMin?: number;
  /** Lado máximo (rem) del tablero SVG en pantallas grandes. */
  ladoMax?: number;
}

const { id = 'tablero-juego', class: className = '', n = 3,
  filas = n,
  ladoMin = 20,
  ladoMax = 36,
} = Astro.props;
---

<div
  id={id}
  class={`tablero-juego ${className}`.trim()}
  style={`--n:${n};--filas:${filas};--lado-min:${ladoMin}rem;--lado-max:${ladoMax}rem`}
>
  <div class="tablero-juego__lateral">
    <div
      id="indicador-turno"
      class="indicador-turno"
      data-jugador="1"
      hidden
    ></div>
    <ControlesPartida />
  </div>
  <slot />
  <div id="banner-ganador" class="banner-ganador" hidden></div>
</div>

<style>
  .tablero-juego {
    /* R1 — tokens compartidos por todos los juegos */
    --gap: 0.25rem;
    --celda-min: 3.5rem;
    --celda-max: 5rem;
    /* Lo que el tablero no puede usar en vertical: cabecera (~2.8rem) +
       barra superior (~2.75rem) + indicador con su hueco (~3.25rem) +
       relleno superior (1rem) + relleno inferior que reserva la barra fija
       de controles (--reserva-barra + 1rem). En horizontal se redefine más
       abajo, porque ahí la barra deja de ser fija y pasa a la columna
       lateral. */
    --reserva-barra: 6.5rem;
    --cromo: 18rem;

    /* R2 — el lado del tablero sale del menor entre ancho y alto disponibles.
       Nota: no se usa `100%` aquí — el ancho de .tablero-juego depende del
       ancho de sus pistas de grid hijas, así que un % referido a ese mismo
       ancho crea una dependencia circular que el navegador resuelve como 0,
       forzando siempre el piso táctil. En horizontal (R5) se redefine con un
       valor fijo que descuenta el panel lateral del marcador. */
    --ancho-disp: 94vw;
    --alto-disp: calc(100svh - var(--cromo));
    --celda-por-ancho: calc((var(--ancho-disp) - (var(--n) - 1) * var(--gap)) / var(--n));
    --celda-por-alto: calc((var(--alto-disp) - (var(--filas) - 1) * var(--gap)) / var(--filas));
    --celda: clamp(
      var(--celda-min),
      min(var(--celda-por-ancho), var(--celda-por-alto)),
      var(--celda-max)
    );

    /* Spec 01 R7 — lado del tablero SVG: el menor entre ancho y alto
       disponibles, acotado por el piso táctil de cada juego (--lado-min,
       que da ≥48px a su zona tocable más pequeña) y por --lado-max. */
    --lado: clamp(
      var(--lado-min),
      min(var(--ancho-disp), var(--alto-disp)),
      var(--lado-max)
    );

    display: flex;
    flex-direction: column;
    align-items: safe center;
    justify-content: safe center;
    gap: 1rem;
    padding: var(--spacing);
    /* La barra de controles es fija: sin esta reserva tapa la fila final. */
    padding-bottom: calc(var(--spacing) + var(--reserva-barra));
    /* R3 — el piso táctil gana: si no cabe, el tablero desborda con scroll */
    overflow: auto;
    overscroll-behavior: contain;
  }

  /* R5 — en horizontal con poca altura, el marcador se coloca al costado
     del tablero en vez de encima, para devolverle esa altura al tablero. */
  @media (orientation: landscape) and (height <= 46rem) {
    .tablero-juego {
      --cromo: 4rem;
      flex-direction: row;
      padding: 0.5rem;
      gap: 0.5rem;
    }

    /* Con el marcador visible al costado, le resta su ancho al tablero. */
    .tablero-juego:has(.indicador-turno:not([hidden])) {
      --ancho-disp: calc(94vw - 9rem - 0.5rem);
    }

    .tablero-juego__lateral {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex-shrink: 0;
      width: 9rem;
    }

    .indicador-turno {
      flex-shrink: 0;
      max-width: 9rem;
    }

    .indicador-turno :global(.fichas-turno) {
      flex-direction: column;
    }

    /* El panel lateral mide 9rem: ahí los avisos sí pueden ocupar varias
       líneas, porque crecen en el panel y no empujan el tablero. */
    .indicador-turno :global(.indicador-turno__badge),
    .indicador-turno :global(.indicador-turno__detalle),
    .indicador-turno :global(.indicador-turno__frase) {
      white-space: normal;
      text-overflow: clip;
    }
  }

  .indicador-turno {
    min-height: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .indicador-turno[hidden] {
    display: none;
  }

  .indicador-turno :global(.indicador-turno__badge) {
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-text);
    animation: badgePopIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    letter-spacing: 0.02em;
    /* Spec 04 R1/R2 — franja reservada de una línea, siempre en el flujo:
       sin aviso queda invisible pero ocupa su alto, así el tablero nunca
       se mueve cuando aparece o desaparece. */
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    box-sizing: border-box;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .indicador-turno :global(.indicador-turno__badge[hidden]) {
    display: flex;
    visibility: hidden;
    animation: none;
  }

  .indicador-turno :global(.fichas-turno) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .indicador-turno :global(.ficha-turno) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-weight: 700;
    background: var(--color-surface);
    opacity: 0.45;
    /* R3 — rebote corto al entrar; scale() no cambia la altura de la franja. */
    transition:
      background-color 0.18s ease,
      opacity 0.18s ease,
      transform 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .indicador-turno :global(.ficha-turno[data-activo='true']) {
    opacity: 1;
  }

  .indicador-turno :global(.ficha-turno[data-jugador='1']) {
    border: 2px dashed color-mix(in srgb, var(--color-player-1) 55%, transparent);
    color: var(--color-player-1);
  }

  .indicador-turno :global(.ficha-turno[data-jugador='2']) {
    border: 2px dashed color-mix(in srgb, var(--color-player-2) 55%, transparent);
    color: var(--color-player-2);
  }

  .indicador-turno :global(.ficha-turno[data-jugador='1'][data-activo='true']) {
    background: var(--color-player-1);
    border-color: var(--color-player-1);
    color: #ffffff;
    transform: scale(1.15);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--color-player-1) 55%, transparent);
  }

  .indicador-turno :global(.ficha-turno[data-jugador='2'][data-activo='true']) {
    background: var(--color-player-2);
    border-color: var(--color-player-2);
    color: #ffffff;
    transform: scale(1.15);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--color-player-2) 55%, transparent);
  }

  .indicador-turno :global(.ficha-turno__nombre) {
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .indicador-turno :global(.ficha-turno__puntaje) {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    /* Spec 04 R4 — reserva ancho para tres dígitos (o "12.5" en Conquista). */
    min-width: 4ch;
    text-align: center;
  }

  /* R1 — frase completa, grande, con el nombre en el color del jugador.
     Línea reservada propia: su alto no depende del texto (spec 04). */
  .indicador-turno :global(.indicador-turno__frase) {
    margin: 0;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 900;
    line-height: 1.3;
    min-height: 1.3em;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: badgePopIn 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .indicador-turno :global(.indicador-turno__frase[data-jugador='1'] .indicador-turno__frase-nombre) {
    color: var(--color-player-1);
  }

  .indicador-turno :global(.indicador-turno__frase[data-jugador='2'] .indicador-turno__frase-nombre) {
    color: var(--color-player-2);
  }

  .indicador-turno :global(.ficha-turno__tu) {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 1;
  }

  .indicador-turno :global([hidden]) {
    display: none;
  }

  /* Spec 04 R1 — detalle y "esperando…" también reservan su línea. */
  .indicador-turno :global(.indicador-turno__detalle) {
    display: block;
    line-height: 1.4;
    min-height: 1.4em;
    max-width: 100%;
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .indicador-turno :global(.indicador-turno__detalle[hidden]) {
    display: block;
    visibility: hidden;
  }

  .indicador-turno :global(.indicador-turno__espera) {
    display: block;
    line-height: 1.4;
    min-height: 1.4em;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .indicador-turno :global(.indicador-turno__prosa) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 28rem) {
    .indicador-turno :global(.fichas-turno) {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .indicador-turno :global(.indicador-turno__badge),
    .indicador-turno :global(.indicador-turno__frase) {
      animation: none;
    }

    .indicador-turno :global(.ficha-turno) {
      transition: none;
    }
  }

  @keyframes badgePopIn {
    0% {
      transform: scale(0.7);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .banner-ganador {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
  }

  .banner-ganador[hidden] {
    display: none;
  }

  .banner-ganador :global(.banner-ganador__contenido) {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }

  .banner-ganador :global(.banner-ganador__acciones) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .banner-ganador :global(.banner-ganador__reiniciar),
  .banner-ganador :global(.banner-ganador__otro-juego) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target-min);
    min-height: var(--tap-target-min);
    padding: 0.5rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 8px;
    border: 2px solid var(--color-accent);
    text-decoration: none;
  }

  .banner-ganador :global(.banner-ganador__reiniciar) {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .banner-ganador :global(.banner-ganador__otro-juego) {
    background: var(--color-surface);
    color: inherit;
  }
</style>
